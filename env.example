# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
# REQUIRED — the server now refuses to start without this set (there is no
# built-in fallback/default value anymore, since a known default secret
# would let anyone who's seen this code forge a valid session cookie for
# any user). Generate a real one, e.g.: openssl rand -hex 32
SESSION_SECRET=

# Postgres connection string. On Render, create a Postgres database and
# either copy its "Internal Database URL" here manually, or (simpler) add
# it as an env var reference from the database's dashboard — Render can
# inject it automatically if you link the DB to the web service.
# Local dev: postgres://user:password@localhost:5432/spm_casino
DATABASE_URL=

# SPWorlds Mini App — create/manage your app at spworlds.ru (see its
# "apps" section). SPWORLDS_MINIAPP_ID is public and also goes into
# public/index.html (SPWMINI_APP_ID constant); the TOKEN is secret and
# stays server-side only — used to verify the signed identity data
# spworlds hands the frontend on every launch.
SPWORLDS_MINIAPP_ID=
SPWORLDS_MINIAPP_TOKEN=

# Discord OAuth2 app — legacy, no longer used now that login is fully
# handled by the SPWorlds Mini App above. Left here only in case Discord
# login is ever reintroduced; safe to leave blank.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://spm-casino.onrender.com/auth/discord/callback

# Public URL this server is reachable at (used to build the spworlds
# payment redirect/webhook URLs, AND to check the Origin header on
# mutating requests as part of CSRF protection — see src/csrf.js. Leave
# empty to auto-detect from the incoming request for the webhook URLs, but
# then Origin-checking has nothing to compare against, so set this
# explicitly in production.
BASE_URL=https://spm-casino.onrender.com

# spworlds.ru card credentials — get from the "Кошелёк" -> "Поделиться картой" section
SPWORLDS_CARD_ID=
SPWORLDS_CARD_TOKEN=
SPWORLDS_API_URL=https://spworlds.ru/api/public

# The card NUMBER (not the API ID/token above). No longer shown to players
# directly (deposits now go through the SPWorlds Mini App payment popup),
# kept only for reference/manual reconciliation.
SPWORLDS_CARD_NUMBER=

# SPWorlds accountId(s) that should be granted admin on first login, comma
# separated. This is only used to BOOTSTRAP the first admin — after that,
# manage roles in the DB. (Old Discord-ID based bootstrap var below is no
# longer read but left in case Discord login ever comes back.)
BOOTSTRAP_ADMIN_SPWMINI_IDS=
BOOTSTRAP_ADMIN_DISCORD_IDS=
